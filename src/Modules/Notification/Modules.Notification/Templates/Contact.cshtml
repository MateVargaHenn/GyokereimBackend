@model Modules.Notification.Infrastructure.Email.Models.ContactMessageNotification

<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Új üzenet érkezett</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f8f0e3;
    font-family: Arial, Helvetica, sans-serif;
    color: #211d19;
    ">
    <table role="presentation"
           width="100%"
           cellspacing="0"
           cellpadding="0"
           border="0"
           style="background-color: #f8f0e3; padding: 20px 0;">
        <tr>
            <td align="center">

                <table role="presentation"
                       width="640"
                       cellspacing="0"
                       cellpadding="0"
                       border="0"
                       style="
                    width: 100%;
                    max-width: 640px;
                    background-color: #ffffff;
                    border: 1px solid #e7d5bc;
                    border-radius: 10px;
                    overflow: hidden;
                    ">

                    <!-- Fejléc -->
                    <tr>
                        <td style="
                            padding: 24px 32px;
                            background-color: #f3e5cf;
                            border-bottom: 1px solid #e1caaa;
                            ">
                            <h1 style="
                                margin: 0 0 6px 0;
                                font-size: 22px;
                                line-height: 1.3;
                                color: #211d19;
                                ">
                                Új kapcsolatfelvételi üzenet érkezett
                            </h1>

                            <p style="
                                margin: 0;
                                font-size: 13px;
                                color: #5f554c;
                                ">
                                Gyökereim
                            </p>
                        </td>
                    </tr>

                    <!-- Tartalom -->
                    <tr>
                        <td style="padding: 30px 32px;">

                            <!-- Kapcsolattartó adatai -->
                            <h2 style="
                                margin: 0 0 18px 0;
                                font-size: 18px;
                                color: #211d19;
                                ">
                                Kapcsolattartó adatai
                            </h2>

                            <table role="presentation"
                                   width="100%"
                                   cellspacing="0"
                                   cellpadding="0"
                                   border="0"
                                   style="
                                background-color: #faf7f2;
                                border: 1px solid #ead8bd;
                                border-radius: 9px;
                                ">
                                <tr>
                                    <td style="
                                        padding: 24px;
                                        font-size: 14px;
                                        line-height: 1.7;
                                        ">
                                        <strong>Név:</strong>
                                        @Model.Name
                                        <br />

                                        <strong>E-mail:</strong>
                                        <a href="mailto:@Model.Email"
                                           style="
                                            color: #0066cc;
                                            text-decoration: none;
                                            ">
                                            @Model.Email
                                        </a>

                                        @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                                        {
                                            <br />
                                            <strong>Telefonszám:</strong>
                                            <a href="tel:@Model.PhoneNumber"
                                               style="
                                                color: #211d19;
                                                text-decoration: none;
                                                ">
                                                @Model.PhoneNumber
                                            </a>
                                        }
                                    </td>
                                </tr>
                            </table>

                            <!-- Üzenet -->
                            <h2 style="
                                margin: 28px 0 18px 0;
                                font-size: 18px;
                                color: #211d19;
                                ">
                                Üzenet
                            </h2>

                            <table role="presentation"
                                   width="100%"
                                   cellspacing="0"
                                   cellpadding="0"
                                   border="0"
                                   style="
                                background-color: #faf7f2;
                                border: 1px solid #ead8bd;
                                border-radius: 9px;
                                ">
                                <tr>
                                    <td style="
                                        padding: 24px;
                                        font-size: 14px;
                                        line-height: 1.7;
                                        white-space: pre-line;
                                        ">
                                        @Model.Message
                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center"
                            style="
                            padding: 20px 32px;
                            background-color: #f3e5cf;
                            border-top: 1px solid #e1caaa;
                            font-size: 12px;
                            color: #5f554c;
                            ">
                            Automatikus értesítés a Gyökereim weboldalról.
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>
</body>
</html>