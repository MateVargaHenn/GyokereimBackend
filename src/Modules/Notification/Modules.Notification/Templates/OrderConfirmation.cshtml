@model Modules.Notification.Infrastructure.Email.Models.OrderNotification

<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Megrendelés visszaigazolása</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f8f0e3;
    font-family: Arial, Helvetica, sans-serif;
    color: #211d19;
">
    <table
        role="presentation"
        width="100%"
        cellspacing="0"
        cellpadding="0"
        border="0"
        style="background-color: #f8f0e3; padding: 32px 16px;"
    >
        <tr>
            <td align="center">

                <table
                    role="presentation"
                    width="100%"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    style="
                        max-width: 640px;
                        background-color: #ffffff;
                        border-radius: 12px;
                        overflow: hidden;
                        border: 1px solid #e5d8c5;
                    "
                >
                    <!-- Fejléc -->
                    <tr>
                        <td style="
                            padding: 28px 32px;
                            background-color: #f3e7d5;
                            border-bottom: 1px solid #e5d8c5;
                        ">
                            <div style="
                                font-family: Georgia, 'Times New Roman', serif;
                                font-size: 24px;
                                font-weight: bold;
                                letter-spacing: 1px;
                            ">
                                GYÖKEREIM
                            </div>

                            <div style="
                                margin-top: 6px;
                                font-size: 13px;
                                color: #6b6258;
                            ">
                                Családfakutatás
                            </div>
                        </td>
                    </tr>

                    <!-- Tartalom -->
                    <tr>
                        <td style="padding: 32px;">
                            <h1 style="
                                margin: 0 0 20px 0;
                                font-size: 24px;
                                line-height: 1.3;
                            ">
                                Kedves @Model.CustomerName!
                            </h1>

                            <p style="
                                margin: 0 0 18px 0;
                                font-size: 16px;
                                line-height: 1.6;
                            ">
                                Köszönöm a megrendelését.
                                A megrendelési igényét sikeresen megkaptam.
                            </p>

                            <p style="
                                margin: 0 0 26px 0;
                                font-size: 16px;
                                line-height: 1.6;
                            ">
                                Hamarosan felveszem Önnel a kapcsolatot a kutatás
                                részleteinek és a további teendőknek az egyeztetéséhez.
                            </p>

                            <!-- Rendelési adatok -->
                            <table
                                role="presentation"
                                width="100%"
                                cellspacing="0"
                                cellpadding="0"
                                border="0"
                                style="
                                    background-color: #faf6ef;
                                    border: 1px solid #eadfce;
                                    border-radius: 8px;
                                    margin-bottom: 28px;
                                "
                            >
                                <tr>
                                    <td style="padding: 20px 24px;">
                                        <h2 style="
                                            margin: 0 0 18px 0;
                                            font-size: 18px;
                                        ">
                                            A megrendelés adatai
                                        </h2>

                                        <p style="margin: 8px 0; line-height: 1.5;">
                                            <strong>Szolgáltatás:</strong>
                                            @Model.ServiceName
                                        </p>

                                        <p style="margin: 8px 0; line-height: 1.5;">
                                            <strong>Ár:</strong>
                                            @Model.Price.ToString("N0") Ft
                                        </p>

                                        <p style="margin: 8px 0; line-height: 1.5;">
                                            <strong>E-mail:</strong>
                                            @Model.Email
                                        </p>

                                        @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                                        {
                                            <p style="margin: 8px 0; line-height: 1.5;">
                                                <strong>Telefonszám:</strong>
                                                @Model.PhoneNumber
                                            </p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(Model.Message))
                                        {
                                            <p style="margin: 18px 0 6px 0;">
                                                <strong>Megjegyzés:</strong>
                                            </p>

                                            <p style="
                                                margin: 0;
                                                line-height: 1.6;
                                                white-space: pre-line;
                                            ">
                                                @Model.Message
                                            </p>
                                        }
                                    </td>
                                </tr>
                            </table>

                            <p style="
                                margin: 0;
                                font-size: 16px;
                                line-height: 1.6;
                            ">
                                Üdvözlettel,<br />
                                <strong>Bánfi Zoltán Csaba</strong><br />
                                Gyökereim
                            </p>
                        </td>
                    </tr>

                    <!-- Lábléc -->
                    <tr>
                        <td style="
                            padding: 22px 32px;
                            background-color: #f3e7d5;
                            border-top: 1px solid #e5d8c5;
                            font-size: 12px;
                            line-height: 1.6;
                            color: #6b6258;
                            text-align: center;
                        ">
                            Ez az üzenet a Gyökereim weboldalon leadott
                            megrendelés alapján automatikusan került kiküldésre.

                            <br />

                            info@gyokereim.hu
                        </td>
                    </tr>
                </table>

            </td>
        </tr>
    </table>
</body>
</html>